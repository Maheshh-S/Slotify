{
  "info": {
    "name": "Slotify API",
    "description": "Concurrency-Safe Slot Booking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"password123\"\n}"}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"password123\"\n}"}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Login successful', function () { pm.expect(pm.response.code).to.equal(200); });", "pm.test('Token exists', function () { pm.expect(pm.response.json().token).to.exist; });", "pm.collectionVariables.set('token', pm.response.json().token);"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events?page=0&size=20"
          }
        },
        {
          "name": "Get Event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/1"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Lock Seat",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/lock-seat",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"seatId\": 1\n}"}
          }
        },
        {
          "name": "Confirm Booking",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/1/confirm",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/1/cancel",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings?page=0&size=10",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        }
      ]
    }
  ]
}